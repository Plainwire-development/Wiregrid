(defun sync-presence-watches (name session users context) (wiregrid_api:sync_presence_watches name session users context))

;; Rooms and signaling.
(defun join-room (name room session) (wiregrid_api:join_room name room session))
(defun join-room (name room session opts) (wiregrid_api:join_room name room session opts))
(defun leave-room (name room session) (wiregrid_api:leave_room name room session))
(defun join-rooms (name rooms session) (wiregrid_api:join_rooms name rooms session))
(defun join-rooms (name rooms session opts) (wiregrid_api:join_rooms name rooms session opts))
(defun leave-rooms (name rooms session) (wiregrid_api:leave_rooms name rooms session))
(defun sync-rooms (name session rooms) (wiregrid_api:sync_rooms name session rooms))
(defun sync-rooms (name session rooms opts) (wiregrid_api:sync_rooms name session rooms opts))
(defun resume-room (name room old-session new-session) (wiregrid_api:resume_room name room old-session new-session))
(defun room-members (name room) (wiregrid_api:room_members name room))
(defun room-members (name room limit) (wiregrid_api:room_members name room limit))
