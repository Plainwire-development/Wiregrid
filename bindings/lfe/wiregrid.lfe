(defun send-user (name user event opts) (wiregrid_api:send_user name user event opts))
(defun send-user-prepared (name user prepared) (wiregrid_api:send_user_prepared name user prepared))
(defun send-user-prepared (name user prepared opts) (wiregrid_api:send_user_prepared name user prepared opts))
(defun send-users (name users event) (wiregrid_api:send_users name users event))
(defun send-users (name users event opts) (wiregrid_api:send_users name users event opts))
(defun send-users-prepared (name users prepared) (wiregrid_api:send_users_prepared name users prepared))
(defun send-users-prepared (name users prepared opts) (wiregrid_api:send_users_prepared name users prepared opts))
(defun dispatch (name targets event) (wiregrid_api:dispatch name targets event))
(defun dispatch (name targets event opts) (wiregrid_api:dispatch name targets event opts))
(defun dispatch-prepared (name targets prepared) (wiregrid_api:dispatch_prepared name targets prepared))
(defun dispatch-prepared (name targets prepared opts) (wiregrid_api:dispatch_prepared name targets prepared opts))
(defun compile-dispatch (name targets) (wiregrid_api:compile_dispatch name targets))
(defun dispatch-plan (name plan event) (wiregrid_api:dispatch_plan name plan event))
(defun dispatch-plan (name plan event opts) (wiregrid_api:dispatch_plan name plan event opts))
(defun dispatch-plan-prepared (name plan prepared) (wiregrid_api:dispatch_plan_prepared name plan prepared))
(defun dispatch-plan-prepared (name plan prepared opts) (wiregrid_api:dispatch_plan_prepared name plan prepared opts))
(defun send-session (name session event) (wiregrid_api:send_session name session event))
(defun send-session (name session event opts) (wiregrid_api:send_session name session event opts))
(defun send-session-prepared (name session prepared) (wiregrid_api:send_session_prepared name session prepared))
(defun send-session-prepared (name session prepared opts) (wiregrid_api:send_session_prepared name session prepared opts))
(defun send-sessions (name sessions event) (wiregrid_api:send_sessions name sessions event))
(defun send-sessions (name sessions event opts) (wiregrid_api:send_sessions name sessions event opts))
(defun send-sessions-prepared (name sessions prepared) (wiregrid_api:send_sessions_prepared name sessions prepared))
(defun send-sessions-prepared (name sessions prepared opts) (wiregrid_api:send_sessions_prepared name sessions prepared opts))
(defun ack (name session) (wiregrid_api:ack name session))
(defun ack (name session delivery-id) (wiregrid_api:ack name session delivery-id))
(defun ack-many (name session delivery-ids) (wiregrid_api:ack_many name session delivery-ids))
(defun pending (name session) (wiregrid_api:pending name session))
(defun decode-payload (name payload) (wiregrid_api:decode_payload name payload))

;; Presence.
(defun presence (name user) (wiregrid_api:presence name user))
(defun set-presence (name session status) (wiregrid_api:set_presence name session status))
(defun set-presence (name session status metadata) (wiregrid_api:set_presence name session status metadata))
(defun watch-presence (name session user) (wiregrid_api:watch_presence name session user))
(defun watch-presence (name session user context) (wiregrid_api:watch_presence name session user context))
(defun unwatch-presence (name session user) (wiregrid_api:unwatch_presence name session user))
(defun watch-presence-many (name session users) (wiregrid_api:watch_presence_many name session users))
(defun watch-presence-many (name session users context) (wiregrid_api:watch_presence_many name session users context))
