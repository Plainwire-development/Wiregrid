(defun room-member? (name room session-id) (wiregrid_api:room_member name room session-id))
(defun subscribed? (name session-id topic) (wiregrid_api:subscribed name session-id topic))
(defun topic-subscriber-count (name topic) (wiregrid_api:topic_subscriber_count name topic))
(defun room-member-count (name room) (wiregrid_api:room_member_count name room))
(defun presence-watcher-count (name user) (wiregrid_api:presence_watcher_count name user))
(defun user-session-count (name user) (wiregrid_api:user_session_count name user))
(defun limits (name) (wiregrid_api:limits name))
(defun delivery-event (name envelope) (wiregrid_api:delivery_event name envelope))
(defun consume-delivery (name envelope handler) (wiregrid_api:consume_delivery name envelope handler))
