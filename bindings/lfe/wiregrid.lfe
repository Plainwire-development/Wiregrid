;; Native-feeling LFE facade for the stable plain-term Wiregrid ABI.
(defmodule wiregrid
  (export all))

;; Instance/session lifecycle.
(defun version () (wiregrid_api:version))
(defun protocol-version () (wiregrid_api:protocol_version))
(defun foreign-protocol-version () (wiregrid_api:foreign_protocol_version))
(defun c-abi-major () (wiregrid_api:c_abi_major))
(defun capabilities (name) (wiregrid_api:capabilities name))
(defun describe (name) (wiregrid_api:describe name))

;; Closed constructors from the stable plain-term ABI. Keeping these here makes
;; the ordinary LFE façade complete; applications can opt into wiregrid_macros
;; for compile-time specialization rather than needing macros for basic terms.
(defun topic-user (id) (wiregrid_api:topic_user id))
(defun topic-channel (id) (wiregrid_api:topic_channel id))
(defun topic-thread (id) (wiregrid_api:topic_thread id))
(defun topic-room (id) (wiregrid_api:topic_room id))
(defun topic-game (id) (wiregrid_api:topic_game id))
(defun topic-document (id) (wiregrid_api:topic_document id))
(defun topic-custom (namespace value) (wiregrid_api:topic_custom namespace value))
(defun target-topic (topic) (wiregrid_api:target_topic topic))
(defun target-room (room) (wiregrid_api:target_room room))
(defun target-user (user) (wiregrid_api:target_user user))
(defun target-session (session) (wiregrid_api:target_session session))
(defun presence-status (status) (wiregrid_api:presence_status status))
(defun presence-custom (status) (wiregrid_api:presence_custom status))
(defun signal-kind (kind) (wiregrid_api:signal_kind kind))

(defun start-instance (name) (wiregrid_api:start_instance name))
(defun start-instance (name opts) (wiregrid_api:start_instance name opts))
(defun stop-instance (name) (wiregrid_api:stop_instance name))
(defun instance-child-spec (name) (wiregrid_api:instance_child_spec name))
(defun instance-child-spec (name opts) (wiregrid_api:instance_child_spec name opts))
(defun connect (name user pid) (wiregrid_api:connect name user pid))
(defun connect (name user pid opts) (wiregrid_api:connect name user pid opts))
(defun connect-resumable (name user pid) (wiregrid_api:connect_resumable name user pid))
(defun connect-resumable (name user pid opts) (wiregrid_api:connect_resumable name user pid opts))
(defun resume-session (name user pid token) (wiregrid_api:resume_session name user pid token))
(defun resume-session (name user pid token opts) (wiregrid_api:resume_session name user pid token opts))
(defun disconnect (name session) (wiregrid_api:disconnect name session))
(defun disconnect (name session reason) (wiregrid_api:disconnect name session reason))
(defun disconnect-user (name user) (wiregrid_api:disconnect_user name user))
(defun disconnect-user (name user reason) (wiregrid_api:disconnect_user name user reason))
(defun set-session-metadata (name session metadata) (wiregrid_api:set_session_metadata name session metadata))

;; Subscriptions and fanout.
(defun subscribe (name session topic) (wiregrid_api:subscribe name session topic))
(defun subscribe (name session topic context) (wiregrid_api:subscribe name session topic context))
(defun unsubscribe (name session topic) (wiregrid_api:unsubscribe name session topic))
(defun subscribe-many (name session topics) (wiregrid_api:subscribe_many name session topics))
(defun subscribe-many (name session topics context) (wiregrid_api:subscribe_many name session topics context))
(defun unsubscribe-many (name session topics) (wiregrid_api:unsubscribe_many name session topics))
(defun sync-subscriptions (name session topics) (wiregrid_api:sync_subscriptions name session topics))
(defun sync-subscriptions (name session topics context) (wiregrid_api:sync_subscriptions name session topics context))
(defun sync-topology (name session topology) (wiregrid_api:sync_topology name session topology))
(defun sync-topology (name session topology opts) (wiregrid_api:sync_topology name session topology opts))
(defun publish (name topic event) (wiregrid_api:publish name topic event))
(defun publish (name topic event opts) (wiregrid_api:publish name topic event opts))
(defun prepare (name event) (wiregrid_api:prepare name event))
(defun publish-prepared (name topic prepared) (wiregrid_api:publish_prepared name topic prepared))
(defun publish-prepared (name topic prepared opts) (wiregrid_api:publish_prepared name topic prepared opts))
(defun publish-batch (name topic events) (wiregrid_api:publish_batch name topic events))
(defun publish-batch (name topic events opts) (wiregrid_api:publish_batch name topic events opts))
(defun publish-topics (name topics event) (wiregrid_api:publish_topics name topics event))
(defun publish-topics (name topics event opts) (wiregrid_api:publish_topics name topics event opts))
(defun publish-topics-prepared (name topics prepared) (wiregrid_api:publish_topics_prepared name topics prepared))
(defun publish-topics-prepared (name topics prepared opts) (wiregrid_api:publish_topics_prepared name topics prepared opts))
(defun publish-room (name room event) (wiregrid_api:publish_room name room event))
(defun publish-room (name room event opts) (wiregrid_api:publish_room name room event opts))
(defun publish-room-prepared (name room prepared) (wiregrid_api:publish_room_prepared name room prepared))
(defun publish-room-prepared (name room prepared opts) (wiregrid_api:publish_room_prepared name room prepared opts))
(defun publish-rooms (name rooms event) (wiregrid_api:publish_rooms name rooms event))
(defun publish-rooms (name rooms event opts) (wiregrid_api:publish_rooms name rooms event opts))
