(defun receipt (name session value) (wiregrid_api:receipt name session value))
(defun receipt (name session value opts) (wiregrid_api:receipt name session value opts))
(defun get-receipt (name session receipt-id) (wiregrid_api:get_receipt name session receipt-id))

;; Bounded read-only query surface.
(defun session (name session-id) (wiregrid_api:session name session-id))
(defun user-sessions (name user-id) (wiregrid_api:user_sessions name user-id))
(defun user-sessions (name user-id limit) (wiregrid_api:user_sessions name user-id limit))
